<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>co.ingloriouslabs.netscan</string>

  <key>ProgramArguments</key>
  <array>
    <!-- install.sh substitutes these placeholders -->
    <string>__PYTHON__</string>
    <string>__APP__</string>
  </array>

  <!-- install.sh injects PYTHONPATH here so the in-app Python can still
       reach the venv's site-packages. When Python lives inside the launcher
       .app, macOS labels Location/TCC entries with the bundle's display name
       ("Inglorious Network Scanner") instead of "Python". -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key><string>__PYTHONPATH__</string>
  </dict>

  <!-- Start immediately on login -->
  <key>RunAtLoad</key><true/>

  <!-- Do NOT keep alive — start at login, stay quit when user closes -->
  <key>KeepAlive</key><false/>

  <key>StandardOutPath</key><string>/tmp/ins.log</string>
  <key>StandardErrorPath</key><string>/tmp/ins.err</string>
</dict>
</plist>
