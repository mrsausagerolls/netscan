<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.wifiscanner</string>

  <key>ProgramArguments</key>
  <array>
    <!-- install.sh substitutes these placeholders -->
    <string>__PYTHON__</string>
    <string>__APP__</string>
  </array>

  <!-- Start immediately on login -->
  <key>RunAtLoad</key><true/>

  <!-- Do NOT keep alive — start at login, stay quit when user closes -->
  <key>KeepAlive</key><false/>

  <key>StandardOutPath</key><string>/tmp/netscan.log</string>
  <key>StandardErrorPath</key><string>/tmp/netscan.err</string>
</dict>
</plist>
